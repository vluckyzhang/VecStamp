<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- VecStamp ribbon. Copyright (c) 2026 vluckyzhang. MIT License.
     image="..." ids are relationship ids of the PNGs in src/icons (see build/make_template.py).
     All texts come from the VBA callbacks (src/i18n/strings.json: "rb.<id>", ".tip", ".sup", ".desc"),
     so the tab follows the language chosen in the About group at once. -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="VS_OnLoad">
  <ribbon>
    <tabs>
      <tab id="vsTab" getLabel="VS_GetLabel" insertAfterMso="TabView" keytip="SY">

        <group id="vsGrpExport" getLabel="VS_GetLabel">
          <splitButton id="vsSplitExport" size="large">
            <button id="vsBtnExport" image="export64" getLabel="VS_GetLabel" onAction="VS_OnExport"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <menu id="vsMnuExport" itemSize="large">
              <menuSeparator id="vsMnuSepVector" getTitle="VS_GetTitle"/>
              <button id="vsMnuEMF" image="emf64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
              <button id="vsMnuEMZ" image="emz64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
              <button id="vsMnuSVG" image="svg64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
              <button id="vsMnuWMF" image="wmf64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
              <menuSeparator id="vsMnuSepDoc" getTitle="VS_GetTitle"/>
              <button id="vsMnuPDF" image="pdf64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
              <button id="vsMnuVSDX" image="vsdx64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
              <menuSeparator id="vsMnuSepRaster" getTitle="VS_GetTitle"/>
              <button id="vsMnuPNG" image="png64" getLabel="VS_GetLabel" onAction="VS_OnExport" getDescription="VS_GetDescription"/>
            </menu>
          </splitButton>
          <button id="vsBtnEMF" label="EMF" image="emf32" onAction="VS_OnExport"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnEMZ" label="EMZ" image="emz32" onAction="VS_OnExport"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnSVG" label="SVG" image="svg32" onAction="VS_OnExport"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnPDF" label="PDF" image="pdf32" onAction="VS_OnExport"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnVSDX" label="VSDX" image="vsdx32" onAction="VS_OnExport"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnPNG" label="PNG" image="png32" onAction="VS_OnExport"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
        </group>

        <group id="vsGrpTools" getLabel="VS_GetLabel">
          <button id="vsBtnBatch" getLabel="VS_GetLabel" size="large" image="pages64" onAction="VS_OnBatch"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnPicture" getLabel="VS_GetLabel" image="picture32" onAction="VS_OnPicture"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnOpenFolder" getLabel="VS_GetLabel" image="folder32" onAction="VS_OnOpenFolder"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
        </group>

        <group id="vsGrpBackground" getLabel="VS_GetLabel">
          <!-- colour preview square + "Background" menu; the custom colour panel is part of the menu.
               Windows draws the preview (vsBgSwatch); macOS shows the static icon of the current background. -->
          <box id="vsBoxBg" boxStyle="horizontal">
            <button id="vsBgSwatch" getImage="VS_GetImage" showLabel="false" getVisible="VS_GetVisible"
                    onAction="VS_OnMoreColors" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <button id="vsBgSwNone" image="bgnone32" showLabel="false" getVisible="VS_GetVisible"
                    onAction="VS_OnMoreColors" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <button id="vsBgSwWhite" image="bgwhite32" showLabel="false" getVisible="VS_GetVisible"
                    onAction="VS_OnMoreColors" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <button id="vsBgSwBeige" image="bgbeige32" showLabel="false" getVisible="VS_GetVisible"
                    onAction="VS_OnMoreColors" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <button id="vsBgSwGrid" image="bggrid32" showLabel="false" getVisible="VS_GetVisible"
                    onAction="VS_OnMoreColors" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <button id="vsBgSwCustom" image="bgcustom32" showLabel="false" getVisible="VS_GetVisible"
                    onAction="VS_OnMoreColors" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            <menu id="vsMnuBg" getLabel="VS_GetLabel" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip">
              <toggleButton id="vsBgNone" image="bgnone32" getLabel="VS_GetLabel" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
              <toggleButton id="vsBgWhite" image="bgwhite32" getLabel="VS_GetLabel" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
              <toggleButton id="vsBgBeige" image="bgbeige32" getLabel="VS_GetLabel" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
              <toggleButton id="vsBgGrid" image="bggrid32" getLabel="VS_GetLabel" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
              <menuSeparator id="vsBgSepCustom" getTitle="VS_GetTitle"/>
              <gallery id="vsGalColor" getLabel="VS_GetLabel" getImage="VS_GetImage" columns="10"
                       itemWidth="16" itemHeight="16" showItemLabel="false" getItemCount="VS_GalColorCount"
                       getItemImage="VS_GalColorImage" getItemScreentip="VS_GalColorTip" onAction="VS_GalColorPick"
                       getVisible="VS_GetVisible" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip">
                <button id="vsBtnMoreColors" getLabel="VS_GetLabel" image="palette32" onAction="VS_OnMoreColors"/>
                <button id="vsBtnEyedropper" getLabel="VS_GetLabel" image="eyedropper32" onAction="VS_OnEyedropper"/>
              </gallery>
              <toggleButton id="vsBgCustomMac" image="bgcustom32" getLabel="VS_GetLabel" getPressed="VS_GetPressed"
                            onAction="VS_OnCheck" getVisible="VS_GetVisible"
                            getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
            </menu>
          </box>
          <editBox id="vsEbRgb" label="RGB" sizeString="#FFFFFF  " maxLength="24"
                   getText="VS_GetText" onChange="VS_OnChange" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <editBox id="vsEbAlpha" getLabel="VS_GetLabel" sizeString="0000" maxLength="3"
                   getText="VS_GetText" onChange="VS_OnChange" getEnabled="VS_GetEnabled"
                   getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <editBox id="vsEbGrid" getLabel="VS_GetLabel" sizeString="0000" maxLength="5"
                   getText="VS_GetText" onChange="VS_OnChange" getEnabled="VS_GetEnabled"
                   getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <editBox id="vsEbMargin" getLabel="VS_GetLabel" sizeString="0000" maxLength="5"
                   getText="VS_GetText" onChange="VS_OnChange"
                   getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
        </group>

        <group id="vsGrpSettings" getLabel="VS_GetLabel">
          <dropDown id="vsDdFormat" getLabel="VS_GetLabel" sizeString="Save to default folder"
                    getSelectedItemIndex="VS_GetIndex" onAction="VS_OnDropDown"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip">
            <item id="vsFmtEMF" label="EMF" image="emf32"/>
            <item id="vsFmtEMZ" label="EMZ" image="emz32"/>
            <item id="vsFmtSVG" label="SVG" image="svg32"/>
            <item id="vsFmtWMF" label="WMF" image="wmf32"/>
            <item id="vsFmtPNG" label="PNG" image="png32"/>
            <item id="vsFmtPDF" label="PDF" image="pdf32"/>
            <item id="vsFmtVSDX" label="VSDX" image="vsdx32"/>
          </dropDown>
          <dropDown id="vsDdMode" getLabel="VS_GetLabel" sizeString="Save to default folder"
                    getItemCount="VS_GetItemCount" getItemLabel="VS_GetItemLabel" getItemID="VS_GetItemID"
                    getSelectedItemIndex="VS_GetIndex" onAction="VS_OnDropDown"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <dropDown id="vsDdNaming" getLabel="VS_GetLabel" sizeString="Save to default folder"
                    getItemCount="VS_GetItemCount" getItemLabel="VS_GetItemLabel" getItemID="VS_GetItemID"
                    getSelectedItemIndex="VS_GetIndex" onAction="VS_OnDropDown"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <separator id="vsSep1"/>
          <dropDown id="vsDdDpi" getLabel="VS_GetLabel" sizeString="Custom WW"
                    getItemCount="VS_GetItemCount" getItemLabel="VS_GetItemLabel" getItemID="VS_GetItemID"
                    getSelectedItemIndex="VS_GetIndex" onAction="VS_OnDropDown"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <editBox id="vsEbDpi" getLabel="VS_GetLabel" sizeString="00000" maxLength="4"
                   getText="VS_GetText" onChange="VS_OnChange" getEnabled="VS_GetEnabled"
                   getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <checkBox id="vsChkVsdx" getLabel="VS_GetLabel" getPressed="VS_GetPressed" onAction="VS_OnCheck"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <separator id="vsSep2"/>
          <checkBox id="vsChkOpen" getLabel="VS_GetLabel" getPressed="VS_GetPressed" onAction="VS_OnCheck"
                    getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnFolder" getLabel="VS_GetLabel" image="setfolder32" onAction="VS_OnFolder"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnReset" getLabel="VS_GetLabel" image="reset32" onAction="VS_OnReset"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <dialogBoxLauncher>
            <button id="vsBtnLauncher" getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"
                    onAction="VS_OnSettings"/>
          </dialogBoxLauncher>
        </group>

        <group id="vsGrpAbout" getLabel="VS_GetLabel">
          <button id="vsBtnAbout" getLabel="VS_GetLabel" size="large" image="logo64" onAction="VS_OnAbout"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <gallery id="vsGalDonate" getLabel="VS_GetLabel" size="large" image="donate64" columns="2"
                   itemWidth="240" itemHeight="302" showItemLabel="false" onAction="VS_OnDonate"
                   getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip">
            <item id="vsDonAlipay" label="Alipay" image="qralipay" screentip="Alipay / 支付宝"/>
            <item id="vsDonWechat" label="WeChat Pay" image="qrwechat" screentip="WeChat Pay / 微信支付"/>
            <button id="vsBtnDonateInfo" getLabel="VS_GetLabel" image="help32" onAction="VS_OnDonateInfo"/>
          </gallery>
          <menu id="vsMnuLang" getLabel="VS_GetLabel" image="lang32"
                getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip">
            <toggleButton id="vsLangZhCN" label="简体中文" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
            <toggleButton id="vsLangZhTW" label="繁體中文" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
            <toggleButton id="vsLangEn" label="English" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
            <toggleButton id="vsLangJa" label="日本語" getPressed="VS_GetPressed" onAction="VS_OnCheck"/>
          </menu>
          <button id="vsBtnHelp" getLabel="VS_GetLabel" image="help32" onAction="VS_OnHelp"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnFeedback" getLabel="VS_GetLabel" image="mail32" onAction="VS_OnFeedback"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
          <button id="vsBtnHome" getLabel="VS_GetLabel" image="home32" onAction="VS_OnHome"
                  getScreentip="VS_GetScreentip" getSupertip="VS_GetSupertip"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
